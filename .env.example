# ==============================================================================
# CUSTODE Platform - Environment Configuration Example
# ==============================================================================
# Copy this file to .env and adjust variables for your target deployment.
# NEVER commit real credentials, passwords, or private keys to version control.
#
# SECRET GENERATION (Execute locally):
#   openssl rand -hex 32
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Deployment Environment
# ------------------------------------------------------------------------------
# Options: development | staging | production
ENVIRONMENT=development

# Application Log Level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Application Debug Mode (MUST be false in staging and production)
DEBUG=true

# ------------------------------------------------------------------------------
# 2. Cryptographic Secrets & Authentication
# ------------------------------------------------------------------------------
# System-wide HMAC and encryption key (Min 32 characters, cryptographically random)
# Generate via: openssl rand -hex 32
SECRET_KEY=dev-secret-key-please-change-in-production-min-32-chars

# JWT Authentication secret key for human user sessions (Min 32 characters)
# Generate via: openssl rand -hex 32
AUTH_SECRET_KEY=dev-auth-jwt-secret-key-please-change-in-production-min-32-chars

# Human User Auth Mode: development (allows dev admin seeded login) | production (strict credentials)
AUTH_MODE=development

# JWT Token Expiration in minutes (e.g., 60 for 1 hour)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# JWT Issuer and Audience claims
AUTH_ISSUER=custode-auth
AUTH_AUDIENCE=custode-control-plane

# ------------------------------------------------------------------------------
# 3. Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_USER=custode
POSTGRES_PASSWORD=custode_dev_password
POSTGRES_DB=custode
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# SQLAlchemy Async Database Connection URL
# Production example: postgresql+asyncpg://<user>:<password>@<db-host>:5432/<db-name>
DATABASE_URL=postgresql+asyncpg://custode:custode_dev_password@postgres:5432/custode

# Database Connection Pool Settings
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# ------------------------------------------------------------------------------
# 4. Networking, CORS, and Reverse Proxy
# ------------------------------------------------------------------------------
# Backend HTTP Bind
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1

# Allowed CORS Origins as a JSON array of URLs
# Production example: ["https://custode.example.com"]
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Forwarded header trust for reverse proxies (Nginx / Cloudflare / Ingress)
FORWARDED_ALLOW_IPS=*

# Ingress Request Body Size Limit in bytes (Default: 10485760 = 10 MB)
MAX_REQUEST_BODY_BYTES=10485760

# ------------------------------------------------------------------------------
# 5. Frontend Client Configuration
# ------------------------------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
