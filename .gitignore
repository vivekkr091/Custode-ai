# ==============================================================================
# CUSTODE Platform - Git Ignore Rules
# ==============================================================================

# Environment variables & secrets
.env
.env.*
!.env.example
*.secret
secrets/
credentials/

# Python Virtual Environments
.venv/
venv/
ENV/
env/
.env/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Python distribution / packaging
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
*.egg
*.whl
*.tar.gz
MANIFEST
.installed.cfg

# Node.js / Frontend
node_modules/
dist/
dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.local

# Database files & backups
*.db
*.db.bak
*.sqlite
*.sqlite3
*.dump
*.backup
*.sql.gz
postgres_data/
docker/data/
backups/

# Logs
*.log
logs/

# Testing & Coverage
.coverage
.coverage.*
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.nox/
.tox/
coverage/
coverage.xml
*.cover

# Operating System & IDEs
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Cryptographic Keys & Certificates
*.pem
*.key
*.crt
*.p12
*.pfx

# Temporary files
tmp/
temp/
