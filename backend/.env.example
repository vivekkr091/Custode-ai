# CUSTODE Backend Service Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

SECRET_KEY=change-this-in-production-min-32-chars

# PostgreSQL Database Connection
POSTGRES_USER=custode
POSTGRES_PASSWORD=custode_dev_password
POSTGRES_DB=custode
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://custode:custode_dev_password@localhost:5432/custode
